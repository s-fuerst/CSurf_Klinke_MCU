# Shell scripts MUST stay LF in the repo AND in the working tree.
# CRLF line endings break bash on every platform. In particular the
# Windows-from-WSL build script is executed by bash inside WSL, which
# requires LF line endings:
#   build-windows-from-wsl.sh\r: No such file or directory
# This rule overrides core.autocrlf (which would otherwise convert
# to CRLF on checkout), so it applies regardless of the local config.
*.sh  text eol=lf
